# Copie este arquivo para .env e preencha. Nunca versione o .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-3.1-flash-lite
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=troque-por-um-segredo-longo
# usuário de demonstração (opcional)
DEMO_EMAIL=
DEMO_SENHA=

# banco de dados (local: SQLite; produção: PostgreSQL da Neon)
DATABASE_URL=sqlite:///./nivela.db
